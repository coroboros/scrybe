# Loaded into the CI job environment by coroboros/ci's rust/test-deps before `cargo test`.
# Both flags flip model/ffmpeg-gated tests from silent-skip to hard-fail, so a green run
# proves the golden transcription and decoder-fallback paths actually executed.
SCRYBE_REQUIRE_MODEL=1
SCRYBE_REQUIRE_FFMPEG=1
SCRYBE_REQUIRE_DIARIZE=1
